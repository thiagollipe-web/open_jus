# Chave pública do DataJud (https://datajud-wiki.cnj.jus.br/api-publica/acesso)
# Bot inteligente (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cobrança do bot: token de admin (obrigatório p/ emitir chaves), franquia grátis diária (tokens), limite por IP/min
ADMIN_TOKEN=
FREE_DAILY_TOKENS=5000
RATE_LIMIT_PER_MIN=60
# SLM local opcional via Ollama (grátis), ex.: http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:0.5b
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# Clone local de https://github.com/ctresb/leis
LEIS_DIR=./data/leis
DB_PATH=./data/openjus.db
LOG_LEVEL=INFO
